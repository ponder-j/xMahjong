# All environment variables use this prefix. Config.local.json explicitly set fields take precedence.
XMAHJONG_LLM_BASE_URL=https://your-provider.example/v1
XMAHJONG_LLM_API_KEY=
XMAHJONG_LLM_MODEL=your-model
# Optional CN Mahjong Soul account. Keep credentials local; never commit .env.
XMAHJONG_MAJSOUL_USERNAME=
XMAHJONG_MAJSOUL_PASSWORD=
